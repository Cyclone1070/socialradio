# Database Connection (Accepts a standard PostgreSQL connection URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socialradio

# Admin Credentials (Loaded by `npm run seed`)
ADMIN_EMAIL=admin@socialradio.com
ADMIN_PASSWORD=AdminPass123!

# Authentication
JWT_SECRET=super_secret_jwt_sign_key_change_me_in_production

# Reddit Fetcher Container (Owns browserless + pacing; see reddit-fetcher/)
REDDIT_FETCHER_URL=http://localhost:3001

# Object Storage / CDN (MinIO in local docker, Cloudflare R2 / AWS S3 in Production)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=socialradio-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_PUBLIC_URL=http://localhost:9000/socialradio-media

# LLM Script Generation (DeepSeek or OpenAI-Compatible APIs like OpenCode/OpenRouter)
DEEPSEEK_API_KEY=your_deepseek_or_opencode_api_key_here
# Optional overrides for alternative providers:
# DEEPSEEK_BASE_URL=https://opencode.ai/zen/go/v1
# DEEPSEEK_MODEL=opencode/deepseek-chat

# Google Cloud API Key (For Text-to-Speech and Gemini API Services)
GEMINI_API_KEY=your_google_cloud_api_key_here
