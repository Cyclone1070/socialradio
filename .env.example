# Two tags are used below, and every entry carries one:
#
#   [required]              the app cannot do that job without it, and it fails loudly when the value
#                           is missing - at boot for the storage credentials, at the first call that
#                           needs it for the rest.
#   [optional, default: X]  the line can be deleted; X is what the code falls back to, and the
#                           values written here are those defaults, so this file works as-is
#                           against the local docker stack.
#
# Where an optional entry has no sensible default, the consequence of leaving it unset is spelled
# out instead of a value.

# Database Connection (a standard PostgreSQL connection URL)
# [optional, default: postgresql://postgres:postgres@localhost:5432/socialradio]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/socialradio

# Admin Credentials - seeded at boot when BOTH are set. There is no seed script.
# [optional] the seeded admin's address - no default
ADMIN_EMAIL=admin@socialradio.com
# [optional] the seeded admin's password - no default. Both are needed: with either one missing,
# no admin account exists at all.
ADMIN_PASSWORD=AdminPass123!

# Authentication
# [optional, default: super_secret_key - a usable but public value; set your own before production]
JWT_SECRET=super_secret_jwt_sign_key_change_me_in_production
# Token lifetime, in whatever duration string the JWT module accepts.
# [optional, default: 1d]
JWT_EXPIRES_IN=1d

# Shared token for GET /channels/active, sent as X-Internal-Token.
# [optional, no default: with it unset, that route refuses every request]
INTERNAL_SERVICE_SECRET=secret

# HTTP
# [optional, default: 3000]
PORT=3000
# [optional, default: info]
LOG_LEVEL=info

# Reddit fetcher sidecar. It owns browserless and the pacing queue, and it scrapes
# anonymously - there are no reddit credentials anywhere in this app.
# [required]
REDDIT_FETCHER_URL=http://localhost:3001
# Our own ceiling per call, rather than Node's five minutes of silence. A real page
# takes 4-9s, so 60s bounds a hung browser job without touching normal traffic.
# [optional, default: 60000]
REDDIT_FETCHER_TIMEOUT_MS=60000

# Object Storage / CDN (SeaweedFS in local docker, Cloudflare R2 / AWS S3 in production)
# [optional, default: http://localhost:9000]
STORAGE_ENDPOINT=http://localhost:9000
# [optional, default: socialradio-media]
STORAGE_BUCKET=socialradio-media
# Credentials are never guessed at: the app refuses to start without them, because a default
# would mean authenticating as whoever that default belongs to.
# [required] must match the "app" identity in deployment/docker/seaweedfs-s3.json
STORAGE_ACCESS_KEY=socialradio-local
# [required] the matching secret
STORAGE_SECRET_KEY=socialradio-local-secret
# The base URL listeners fetch audio chunks from.
# [optional, default: <STORAGE_ENDPOINT>/<STORAGE_BUCKET>]
STORAGE_PUBLIC_URL=http://localhost:9000/socialradio-media

# LLM Script Generation (OpenRouter / any OpenAI-compatible endpoint)
# [required] the provider key
LLM_API_KEY=your_openrouter_api_key_here
# [required] the OpenAI-compatible base URL
LLM_BASE_URL=https://openrouter.ai/api/v1
# [required] the model name that provider answers to
LLM_MODEL=inclusionai/ling-3.0-flash-sante:free

# Station Idle Configuration (Virtual Clock Engine)
# [optional, default: 600]
IDLE_TIMEOUT_SECONDS=600

# Where the speech service lives. The app sends a script and stores the audio it
# answers with; swapping engines means pointing this somewhere else.
# [required]
VOICE_SERVICE_URL=http://localhost:3002
