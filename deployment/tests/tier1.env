# Tier 1 environment. Dummy values only: no provider keys, no real credentials.
# The app, migration and suite containers all read this file (docker-compose.test.yml
# binds it with !override), so local runs and CI get byte-identical settings and a
# developer's own .env cannot change the outcome of a Tier 1 run.
ADMIN_EMAIL=admin@socialradio.com
ADMIN_PASSWORD=AdminPass123!
JWT_SECRET=tier1-jwt-secret
IDLE_TIMEOUT_SECONDS=600
